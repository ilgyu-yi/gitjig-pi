{
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],

		// noUncheckedIndexedAccess stays OFF — a decision, not an omission
		// (issue #137). Triaged 2026-09-09 at 78 violation sites: 74 provably
		// in range at the call site (length-asserted, mandatory regex group,
		// or loop-bounded — each repair a non-null assertion the guard already
		// justifies), 4 more in range but better repaired by a restructure
		// than an assertion, 0 genuinely unchecked: every index is guarded
		// and none can reach an out-of-range slot, so the flag would have
		// caught nothing here. A tree of 74 `!` marks buys no defect and
		// hides the guards that do the work. Reopen if a triage ever finds a
		// site in the wrong-allow shape, or if
		// `tsc --noEmit --noUncheckedIndexedAccess | grep -c '^\.pi/'` (from
		// the repo root, toolchain installed) ever counts more than the 4
		// error lines it counts today (a different four than the restructure
		// class — this counts by directory, and it counts the compiler's
		// error lines, not sites, so a swap or an unflagged addition hides
		// in it). The tripwire is a proxy: any rise in that line count fires
		// it, benign guarded additions included, and a trip costs only a
		// re-triage; the per-site table is on issue #137.
		"strict": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,

		"noEmit": true
	},
	"include": [".pi/**/*.ts", "test/**/*.ts"]
}
