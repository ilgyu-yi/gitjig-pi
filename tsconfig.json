{
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],

		// noUncheckedIndexedAccess stays OFF — a decision, not an omission
		// (issue #137). Triaged 2026-09-09 at 78 violation sites: 74 provably
		// in range at the call site (length-asserted, mandatory regex group,
		// or loop-bounded — each repair a non-null assertion the guard already
		// justifies), 4 restructures, 0 genuinely unchecked — no site lets an
		// out-of-range undefined flow into a decision silently; every one
		// throws, the safe direction. A tree of 74 `!` marks buys no defect
		// and hides the guards that do the work. Reopen if a triage ever
		// finds a site in the wrong-allow shape, or if the indexing parsers
		// grow faster than their guards; the per-site table is on issue #137.
		"strict": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,

		"noEmit": true
	},
	"include": [".pi/**/*.ts", "test/**/*.ts"]
}
