{
	"name": "gitjig-pi",
	"private": true,
	"type": "module",
	"description": "Development and CI tooling manifest. Not part of the substrate an adopting repository receives; the runtime stays buildless.",
	"scripts": {
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"check": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "node --test \"test/*.test.ts\""
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.14",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@types/node": "24.10.2",
		"typescript": "5.9.3"
	}
}
