#!/usr/bin/env bash
# .githooks/commit-msg — local-tier adapter. Reads the first non-blank line
# of the message file git passes as $1 and calls check_commit_subject on it —
# it copies NO check logic (single-source). It
# deliberately does NOT reuse the command-string subject parser: at the git
# layer there is no command string, only the message file git hands us.
#
# WHY THE FIRST NON-BLANK LINE, AND NOT THE FIRST NON-COMMENT ONE
# (issue #58). This hook receives ONE argument, the message path. It does not
# receive the cleanup mode and cannot derive it: `--cleanup=` is a
# command-line flag no hook sees, `commit.cleanup` may be unset, and git's
# default DIFFERS BY INVOCATION — `strip` for an editor commit, `whitespace`
# for `-m`/`-F`. Under `strip` git removes comment lines after this hook
# returns; under `whitespace` and `verbatim` it removes nothing.
#
# Reading past comments was a silent WRONG ALLOW, measured: `#comment` on
# line 1 with a conforming subject on line 2 was approved on line 2 while
# line 1 landed as the subject, with no refusal and no record.
#
# The repair needs no mode, and needs no comment marker either. A line git
# would strip as a comment cannot be a conforming subject under this grammar
# — no comment marker is a valid `<type>` — so a message whose first line is
# a comment is refused whichever way the cleanup falls, and a message whose
# first line is NOT a comment has that line as its subject under every mode.
# Checking the first non-blank line therefore decides every case correctly
# without consulting `core.commentChar`, `core.commentString`, or the mode.
# That is why no marker is read here: a marker-aware second reading was
# written first and then removed, because no input could be found on which it
# changed the outcome.
#
# Enumerated in place (§3.11), and NOT closed here:
#   - THE FALSE BLOCK THIS BUYS. Under `strip` a leading comment IS removed,
#     so a `commit.template` that opens with comments is refused although the
#     conforming subject beneath it would have landed. That is the cost of
#     refusing what the hook cannot vouch for, it is named in the refusal
#     itself, and the tier's `--no-verify` recovery is live on it.
#   - HOOK-LESS CHANNELS. `git cherry-pick` never fires `commit-msg`
#     (measured: a fabricated violating subject cherry-picks cleanly through
#     an armed chain), and `git am` applies mail-formatted patches on the
#     same footing. Those channels bypass this predicate structurally, not by
#     a gap in it, and no adapter here can reach them.
#   - THE MERGE EDGE. `git merge` does fire `commit-msg`, and git's default
#     merge message violates this grammar; pinned in
#     `test/commit-format.githook.test.ts`'s residual block.
# The tier's own door (§3.8's declared deferral) stands beneath all of these.
# shellcheck source=/dev/null
. "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

githook_source conventional_commit.sh commit-format || exit 0
githook_require check_commit_subject commit-format

_gh_msgfile="${1:-}"
[ -n "$_gh_msgfile" ] && [ -f "$_gh_msgfile" ] || exit 0

# THE SUBJECT CANDIDATE IS THE FIRST NON-BLANK LINE. Blank lines are skipped
# because no cleanup mode makes a blank line the subject; nothing else is.
_gh_subject=""
while IFS= read -r _gh_line || [ -n "$_gh_line" ]; do
  case "$_gh_line" in
    '') continue ;;
  esac
  _gh_subject="$_gh_line"
  break
done < "$_gh_msgfile"

# Empty message -> let git's own empty-message handling deal with it
# (fail-open). A message that is entirely comments is NOT empty here: under a
# comment-preserving cleanup those bytes are the subject.
[ -n "$_gh_subject" ] || exit 0

# check_commit_subject writes the CAUSE to stderr itself (format violation, an
# out-of-range length, or a length it could not measure at all). This
# adapter must NOT re-state a cause of its own: naming "not a Conventional
# Commit" for a measurement failure would be actively false. It appends only the
# recovery live at THIS tier: the git-hook tier is advice and
# folds to --no-verify. The SKIP_HOOKS env-prefix escape form is deliberately
# absent — should_skip is never reached from here, so it would name a dead escape.
if ! check_commit_subject "$_gh_subject"; then
  githook_block commit-format "commit-msg: subject rejected — see the reason above. Expected <type>(#<N>)[!]: <subject> with a subject of 1..72 codepoints; a length that cannot be measured is refused, not approved. The line checked is the message's first non-blank line, because which line becomes the subject depends on a cleanup mode this hook cannot observe. Fix the message, or re-run with --no-verify (this tier is advice)."
  exit 1
fi

exit 0
